{
  "name": "caricatura3d",
  "private": true,
  "description": "Vídeos de suspenso: personajes 2D en escenarios 3D (Three.js + Remotion)",
  "type": "module",
  "scripts": {
    "estudio": "remotion studio",
    "alejandro:foto": "remotion still Alejandro salida/alejandro_f020.png --frame=20 --props=props/sin_audio.json",
