    "@remotion/three": "4.0.522",
    "postprocessing": "^6.39.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "remotion": "4.0.522",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
